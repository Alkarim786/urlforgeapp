# Server & Environment
ENVIRONMENT="development"
APP_URL="http://localhost:8000"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://urlforge_user:urlforge_pass@localhost:5432/urlforge_db"

# Cache Configuration (Redis)
REDIS_URL="redis://localhost:6379/0"

# Rate Limiting & URL Configuration
RATE_LIMIT_PER_MINUTE=100
CACHE_TTL_SECONDS=86400
DEFAULT_URL_EXPIRY_DAYS=30

# AI Studio injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
